rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is super admin by email
    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.email == '0319sea2@gmail.com' ||
        (request.auth.token.email is string && request.auth.token.email.matches('(?i)^0319sea2@gmail\\.com$'))
      );
    }

    // Check if user is admin (super admin or registered in admins collection)
    function isAdmin() {
      return isSuperAdmin() || (
        request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Notices: anyone can read, create, update, delete
    match /notices/{noticeId} {
      allow read, write: if true;
    }

    // Activity Posts / Gallery
    match /gallery/{galleryId} {
      allow read, write: if true;
    }

    match /posts/{postId} {
      allow read, write: if true;
    }

    // Group / Public Chat Messages
    match /group_chat_messages/{messageId} {
      allow read, write: if true;
    }

    // 1:1 Consultation Chat Rooms and Messages
    match /direct_chats/{chatId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Legacy consultation rooms
    match /consultation_rooms/{roomId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Admin collection
    match /admins/{adminId} {
      allow read, write: if true;
    }
  }
}
